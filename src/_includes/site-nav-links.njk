{%- set L = language or 'de' -%}
{%- set U = blogui[L] -%}
{%- set home = '/' + L + '/insights/' -%}
{%- set starts = (collections.insightsDE if L == 'de' else collections.insightsEN) | topicStarts -%}
<ul class="nav__links">
            <li><button type="button" class="nav__search" data-blog-search-open aria-label="{{ U.nav.search }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><span>{{ U.nav.search }}</span></button></li>
            <li><a href="{{ home }}"{% if page.url == home %} class="active" aria-current="page"{% endif %}>{{ U.nav.latest }}</a></li>
            <li class="has-sub">
              <a href="{{ home }}" class="nav__parent" aria-haspopup="true"><span>{{ U.nav.topics }}</span><svg class="chev" width="10" height="10" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></a>
              <ul class="nav__sub">
                {%- for slug in starts | topicSlugs(U.topicOrder) %}
                <li data-live-from="{{ starts[slug] }}"><a href="{{ home }}?topic={{ slug }}">{{ slug | topicLabel(U.topics) }}</a></li>
                {%- endfor %}
                <li class="nav__sub-all"><a href="{{ home }}">{{ U.nav.allArticles }} →</a></li>
              </ul>
            </li>
            <li class="has-sub">
              <a href="https://konihaus.ch/" class="nav__parent" aria-haspopup="true"><span>{{ U.nav.konihaus }}</span><svg class="chev" width="10" height="10" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></a>
              <ul class="nav__sub nav__sub--wide">
                <li><a href="https://konihaus.ch/" data-i18n="nav.website">Website</a></li>
                <li><a href="https://app.konihaus.ch" target="_blank" rel="noopener"><span data-i18n="nav.app">App</span><span class="nav__badge" data-i18n="nav.new">Neu</span></a></li>
                <li class="nav__sub-label">{{ U.nav.company }}</li>
                <li><a href="https://konihaus.ch/#intro" data-i18n="footer.col2_l1">Was ist Konihaus</a></li>
                <li><a href="https://konihaus.ch/#process" data-i18n="footer.col2_l2">So funktioniert&#x27;s</a></li>
                <li><a href="https://konihaus.ch/#why" data-i18n="footer.col2_l3">Warum Konihaus</a></li>
                <li><a href="https://konihaus.ch/#about" data-i18n="footer.col2_l4">Über Koni</a></li>
                <li class="nav__sub-label">{{ U.nav.service }}</li>
                <li><a href="https://konihaus.ch/#devices" data-i18n="footer.col1_l2">Geräte &amp; Technik</a></li>
                <li><a href="https://konihaus.ch/home-assistant-schweiz" data-ha-link data-i18n="footer.col1_l5">Home Assistant Schweiz</a></li>
                <li><a href="https://konihaus.ch/#packages" data-i18n="footer.col1_l1">Pakete &amp; Preise</a></li>
                <li><a href="https://konihaus.ch/#faq" data-i18n="footer.col1_l3">Häufige Fragen</a></li>
                <li><a href="https://konihaus.ch/#contact" data-i18n="footer.col1_l4">Kontakt</a></li>
              </ul>
            </li>
          </ul>
{#- Compact header: below 900px the link row is hidden, so search sits in the middle of the bar and opens the overlay -#}
<button type="button" class="nav__searchbar" data-blog-search-open aria-label="{{ U.nav.search }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><span>{{ U.ui.searchPlaceholder }}</span></button>
