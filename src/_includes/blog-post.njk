            {% if post.fileSlug === slug %}
              {% set relatedCount = relatedCount + 1 %}
            {% endif %}
          {% endfor %}
        {% endfor %}
        {% if relatedCount > 0 %}
          <section class="blog-post__related" aria-label="{% if language === 'de' %}Weiterlesen{% else %}Related reading{% endif %}">
