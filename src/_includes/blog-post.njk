{#- Category label: explicit `category` front matter, else the first tag.
    (Named categoryLabel and fed with values, because a macro called `category`
    would shadow the `category` front matter field in this template.) -#}
{% macro categoryLabel(c, tags) -%}
  {%- if not c and tags -%}
    {%- set first = tags if tags is string else tags[0] -%}
    {%- set c = (first.split(',')[0]) | trim -%}
  {%- endif -%}
  {%- if c %}{{ c | replace("-", " ") }}{% endif -%}
{%- endmacro %}

{#- Open every link in the article body in a new window, except in-page anchors
    (#...), mailto: and tel: links, and links that already set a target. -#}
{% macro openLinksInNewTab(html) -%}
  {{- html | replace(r/<a\s+(?![^>]*\btarget=)(?![^>]*\bhref="(?:#|mailto:|tel:))([^>]*)>/g, '<a target="_blank" rel="noopener noreferrer" $1>') | safe -}}
{%- endmacro %}
{% set shareUrl = "https://blog.konihaus.ch" + page.url %}
{% set altUrl = "https://blog.konihaus.ch" + permalinkalt %}
{% set ogImage = image or "/images/insights/" + ogimage %}
<!DOCTYPE html>
<html lang="{{ language }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <!-- Hide content until JS loads and sets language -->
  <script>
    document.documentElement.classList.add('no-js');
    document.documentElement.classList.add("fonts-loading");
  </script>
  <style>
    html.no-js body {
      display: none;
    }
    html.fonts-loading body {
      visibility: hidden;
    }
  </style>
  <meta name="theme-color" content="#2a4a35">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon_sm.svg">
  <link rel="apple-touch-icon" href="/assets/favicon.svg">
  <title>{{ title }} - Konihaus</title>
  <meta name="description" content="{{ excerpt or title }}">
  <meta name="author" content="Konrad Hefelle">

  <!-- Canonical + language alternates -->
  <link rel="canonical" href="{{ shareUrl }}">
  {% if language === 'de' %}
  <link rel="alternate" hreflang="de" href="{{ shareUrl }}">
  <link rel="alternate" hreflang="en" href="{{ altUrl }}">
  {% else %}
  <link rel="alternate" hreflang="en" href="{{ shareUrl }}">
  <link rel="alternate" hreflang="de" href="{{ altUrl }}">
  {% endif %}
  <link rel="alternate" hreflang="x-default" href="{{ shareUrl }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ excerpt or title }} - Konihaus">
  <meta property="og:description" content="{{ excerpt or title }}">
  <meta property="og:url" content="{{ shareUrl }}">
  <meta property="og:type" content="article">
  <meta property="og:image" content="https://blog.konihaus.ch{{ ogImage }}">
  <meta property="og:locale" content="{% if language === 'de' %}de_CH{% else %}en_US{% endif %}">
  <meta property="og:locale:alternate" content="{% if language === 'de' %}en_US{% else %}de_CH{% endif %}">
  <meta property="article:published_time" content="{{ date }}">
  {% if dateModified %}<meta property="article:modified_time" content="{{ dateModified }}">{% endif %}
  <meta property="article:author" content="Konrad Hefelle">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ excerpt or title }} - Konihaus">
  <meta name="twitter:description" content="{{ excerpt or title }}">
  <meta name="twitter:image" content="https://blog.konihaus.ch{{ ogImage }}">

  <!-- Structured data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | dump | safe }},
    "description": {{ (excerpt or title) | dump | safe }},
    "image": {{ ("https://blog.konihaus.ch" + ogImage) | dump | safe }},
    "datePublished": {{ date | dump | safe }},
    "dateModified": {{ (dateModified or date) | dump | safe }},
    "inLanguage": {{ language | dump | safe }},
    "mainEntityOfPage": {{ shareUrl | dump | safe }},
    "author": {
      "@type": "Person",
      "name": "Konrad Hefelle"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Konihaus",
      "logo": {
        "@type": "ImageObject",
        "url": "https://blog.konihaus.ch/assets/logo.png"
      }
    }
  }
  </script>

  <link
    rel="preload"
    href="/fonts/outfit-latin-normal.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  >
  <link
    rel="preload"
    href="/fonts/cormorant-garamond-latin-normal.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  >
  <link
    rel="preload"
    href="/fonts/cormorant-garamond-latin-italic.woff2"
    as="font"
    type="font/woff2"
    crossorigin
