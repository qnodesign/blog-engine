  <script>
    const lang = "{{language}}";

    function switchToDe() {
      if (lang === 'de') return;
      location.href = '{{permalinkalt}}'
    }

    function switchToEn() {
      if (lang === 'en') return;
      location.href = '{{permalinkalt}}'
    }

    (function () {
      const shareUrl = "{{ shareUrl }}";
      const shareTitle = {{ (excerpt or title) | dump | safe }};
      const encodedUrl = encodeURIComponent(shareUrl);
      const encodedTitle = encodeURIComponent(shareTitle);

      const links = {
        x: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
        linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
        facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
        whatsapp: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
        email: `mailto:?subject=${encodedTitle}&body=${encodedUrl}`,
      };
 
      document.querySelectorAll('[data-share]').forEach((el) => {
        const platform = el.getAttribute('data-share');
        if (links[platform]) el.href = links[platform];
      });

      /*if (navigator.share) {
        const fbIcons = document.querySelectorAll('[data-share="facebook"]');
        fbIcons.forEach((el) => {
          el.addEventListener('click', (e) => {
            e.preventDefault();
            navigator.share({ title: shareTitle, url: shareUrl }).catch(() => {});
          });
        });
      }*/

      const isTouchMobile = window.matchMedia('(pointer: coarse)').matches
        && /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);

      if (isTouchMobile && navigator.share) {
        document.querySelectorAll('[data-share="native"]').forEach((el) => {
          el.addEventListener('click', (e) => {
            e.preventDefault();
            navigator.share({ title: shareTitle, url: shareUrl }).catch(() => {});
          });
        });
        const fbIcons = document.querySelectorAll('[data-share="facebook"]');
        fbIcons.forEach((el) => {
          el.addEventListener('click', (e) => {
            e.preventDefault();
            navigator.share({ title: shareTitle, url: shareUrl }).catch(() => {});
          });
        });
      }

      document.querySelectorAll('[data-copy-link]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(shareUrl);
            btn.setAttribute('data-copied', 'true');
            setTimeout(() => btn.removeAttribute('data-copied'), 2000);
          } catch {
            
          }
        });
      });
    })();
  </script>
</body>
</html>