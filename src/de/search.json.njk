---
permalink: /de/search.json
eleventyExcludeFromCollections: true
---
{%- set U = blogui['de'] -%}
[
{%- for post in collections.insightsDE %}
{{ '' if loop.first else ',' }}{{ {
  "t": post.data.title,
  "u": post.url,
  "d": post.date.toISOString().slice(0, 10),
  "tm": post.data.time or '',
  "c": post.data.category or '',
  "cl": (post.data.category | topicLabel(U.topics)) if post.data.category else '',
  "e": post.data.excerpt or '',
  "g": post.data.tags or [],
  "k": post.data.keyword or '',
  "r": post.data.readingtime or '',
  "df": post.data.date | dateFormatDE,
  "i": ("/images/insights/" + post.data.ogimage) if post.data.ogimage else '',
  "b": (post.templateContent | striptags(true) | truncate(2500, true, ''))
} | dump | safe }}
{%- endfor %}
]
